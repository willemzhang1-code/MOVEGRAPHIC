{
  "name": "sinew-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "cd .. && cargo build -p sinew-ffi --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/sinew_ffi.wasm web/public/sinew.wasm",
    "gen": "node ../tools/gen-demo.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/delaunator": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "delaunator": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
