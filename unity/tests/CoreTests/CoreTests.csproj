<Project Sdk="Microsoft.NET.Sdk">
  <!-- Exercises the engine-independent runtime (Runtime/Core) against the native library, without Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../com.rabbit.runtime/Runtime/Core/*.cs" />
  </ItemGroup>
</Project>
